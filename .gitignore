# Copy to <repo>/.gitignore before the first commit.

# private working material (never published)
notes/
drafts/
submission/
work_samples/
build/
logs/
local.env
.env
*.docx
job_posting.txt
cover_letter*.txt

# client material (confidential, never commit or publish)
correspondance/
correspondence/
client_*/
data/client/

# raw and bulky data: keep only the provenance files
data/raw/*
!data/raw/README.md
!data/raw/MANIFEST.tsv
data/processed/

# regenerable or bulky run outputs (keep summary JSON, tables and figures)
runs/*/pages/
runs/smoke/
results/*/raw/

# caches and tooling
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
slurm-*.out
*.log

# generated by the stand-in platforms when run
stand_in/*/data/
stand_in/*/outputs/
coverage.json
.coverage
.ruff_cache/
